# Frontend configuration — copy to `.env.local` and fill in real values.
# Never commit `.env.local` (it holds real secrets).

# Base URL of the CommonGround Express backend API.
NEXT_PUBLIC_API_URL=http://localhost:5000

# BetterAuth: this app's own origin and a long random secret.
# e.g. `openssl rand -hex 32`
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# MongoDB (Atlas) connection used by the BetterAuth MongoDB adapter.
# Same database as the backend (collections: user, session, account, jwks).
MONGODB_URI=<your-atlas-connection-string>
DB_NAME=commonground

# Google OAuth credentials (Google Cloud Console > OAuth consent + client).
# Missing credentials leave Google sign-in disabled (the button shows an
# explanatory toast instead of logging in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
